<%# locals: (form:, types: nil, auto_submit: false) %>

<%# Boxes show only what is actually selected. Nothing checked means no
    filtering, so you start from everything and check the types you want to
    narrow to. Checking all three is equivalent to none -- see
    EntrySearch.type_condition. %>
<% selected = Array(types) %>

<%# The global filter menu applies on its own Apply button, so auto-submit is
    opt-in -- submitting per checkbox there would close the menu mid-selection. %>
<% checkbox_data = auto_submit ? { "auto-submit-form-target": "auto" } : {} %>

<div class="p-2 space-y-3">
  <% [ [ "income", t(".income") ], [ "expense", t(".expense") ], [ "transfer", t(".transfer") ] ].each do |value, label| %>
    <div class="flex items-center gap-3" data-filter-name="<%= value %>">
      <%= form.check_box :types,
                         {
                           multiple: true,
                           checked: selected.include?(value),
                           class: "checkbox checkbox--light",
                           data: checkbox_data
                         },
                         value,
                         nil %>
      <%= form.label :types, label, value: value, class: "text-sm text-primary" %>
    </div>
  <% end %>
</div>
