<%# locals: (form:) %>
<div data-controller="list-filter">
  <div class="relative">
    <input type="search" autocomplete="off" placeholder="Filter category" data-list-filter-target="input" data-action="input->list-filter#filter" class="block w-full bg-container border border-secondary rounded-md py-2 pl-10 pr-3 focus:ring-gray-500 sm:text-sm">
    <%= icon("search", class: "absolute inset-y-0 left-2 top-1/2 transform -translate-y-1/2") %>
  </div>
  <div class="my-2 space-y-1" id="list" data-list-filter-target="list">
    <% Category::Group.for(family_categories).each do |group| %>
      <% if group.subcategories.empty? %>
        <%= render "transactions/searches/filters/category_option", form: form, category: group.category %>
      <% else %>
        <%# The parent keeps a checkbox of its own -- it is an assignable
            category, not just a heading -- and ticking it ticks the whole group. %>
        <div class="rounded-lg bg-container-inset p-1" data-controller="checkbox-group" data-filter-group>
          <%= render "transactions/searches/filters/category_option",
                     form: form,
                     category: group.category,
                     checkbox_data: { checkbox_group_target: "parent", action: "change->checkbox-group#toggleAll" } %>

          <div class="rounded-md bg-container" data-filter-group>
            <% group.subcategories.each do |subcategory| %>
              <%# The parent name joins the search text so filtering by it keeps the whole group. %>
              <%= render "transactions/searches/filters/category_option",
                         form: form,
                         category: subcategory,
                         filter_name: "#{group.name} #{subcategory.name}",
                         nested: true,
                         checkbox_data: { checkbox_group_target: "child" } %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
