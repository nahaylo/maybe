<%= content_for :page_title, t(".title") %>

<div class="bg-container shadow-border-xs rounded-xl p-4 grow overflow-y-auto">
  <% if @releases.empty? %>
    <p class="text-secondary text-sm md:px-3">No changelog is available for this build.</p>
  <% end %>

  <% @releases.each do |release| %>
    <div class="flex flex-col md:flex-row justify-between gap-4 mb-12 last:mb-0">
      <div class="w-full md:w-1/3 md:px-3">
        <div class="text-primary font-medium text-sm"><%= release.version %></div>
        <% if release.date %>
          <div class="text-secondary text-sm"><%= release.date.strftime("%B %d, %Y") %></div>
        <% end %>
      </div>
      <div class="w-full md:w-2/3 text-secondary text-sm prose prose--github-release-notes">
        <h2 class="mb-5 text-xl text-primary"><%= sanitize release.title_html %></h2>
        <%= sanitize release.body_html %>
      </div>
    </div>
  <% end %>
</div>
