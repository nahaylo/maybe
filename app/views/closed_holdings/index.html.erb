<%= turbo_frame_tag dom_id(@account, "closed") do %>
  <div class="bg-container space-y-4 p-5 rounded-xl shadow-border-xs">
    <div class="flex items-center justify-between">
      <%= tag.h2 "Closed positions", class: "font-medium text-lg" %>
      <%= tag.p "Sold out entirely. A position bought again later counts as held.", class: "text-sm text-secondary" %>
    </div>

    <div class="bg-container-inset rounded-xl p-1">
      <div class="grid grid-cols-12 items-center uppercase text-xs font-medium text-secondary px-4 py-2">
        <%= tag.p "Name", class: "col-span-4" %>
        <%= tag.p "Sold", class: "col-span-2 justify-self-end" %>
        <%= tag.p "Cost", class: "col-span-2 justify-self-end" %>
        <%= tag.p "Realised", class: "col-span-2 justify-self-end" %>
        <%= tag.p "Total return", class: "col-span-2 justify-self-end" %>
      </div>

      <div class="bg-container rounded-lg shadow-border-xs">
        <% if @holdings.any? %>
          <%= render partial: "closed_holdings/holding", collection: @holdings, spacer_template: "shared/ruler" %>
        <% else %>
          <%= tag.p "Nothing sold out yet.", class: "text-secondary text-sm p-4" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
